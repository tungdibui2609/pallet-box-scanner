{
  "expo": {
    "name": "Anywarehouse",
    "slug": "bao-duy",
    "version": "1.0.88",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ea580c"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anywarehouse.scanner",
      "versionCode": 89,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ea580c",
          "image": "./assets/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ứng dụng sử dụng Camera để quét tem thùng hàng."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để tải ảnh con dấu."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Ứng dụng cần quyền Microphone để ghi âm ghi chú kiểm kê."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ứng dụng cần quyền Microphone để nhân viên nói chuyển thành ghi chú kiểm kê.",
          "speechRecognitionPermission": "Ứng dụng cần quyền nhận dạng giọng nói để chuyển lời nói thành văn bản ghi chú kiểm kê."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5fba333e-02a0-4b9b-a833-4a101edc7124"
      }
    },
    "owner": "dinhtung"
  }
}