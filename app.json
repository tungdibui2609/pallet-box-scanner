{
  "expo": {
    "name": "Anywarehouse",
    "slug": "bao-duy",
    "version": "1.0.60",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anywarehouse.scanner",
      "versionCode": 61,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ứng dụng sử dụng Camera để quét tem thùng hàng."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "337c08b1-018e-439a-9b8a-ee0d49fc438c"
      }
    },
    "owner": "bkbaoduys-team"
  }
}
